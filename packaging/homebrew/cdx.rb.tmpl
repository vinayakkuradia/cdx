# Homebrew formula for cdx. Rendered by scripts/render-packaging.sh at release time.
class Cdx < Formula
  desc "Fast, cross-platform interactive directory navigator that extends cd"
  homepage "https://github.com/{{REPO}}"
  version "{{VERSION}}"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/{{REPO}}/releases/download/{{TAG}}/cdx-aarch64-apple-darwin.tar.gz"
      sha256 "{{SHA_AARCH64_APPLE_DARWIN}}"
    end
    on_intel do
      url "https://github.com/{{REPO}}/releases/download/{{TAG}}/cdx-x86_64-apple-darwin.tar.gz"
      sha256 "{{SHA_X86_64_APPLE_DARWIN}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/{{REPO}}/releases/download/{{TAG}}/cdx-aarch64-unknown-linux-musl.tar.gz"
      sha256 "{{SHA_AARCH64_UNKNOWN_LINUX_MUSL}}"
    end
    on_intel do
      url "https://github.com/{{REPO}}/releases/download/{{TAG}}/cdx-x86_64-unknown-linux-musl.tar.gz"
      sha256 "{{SHA_X86_64_UNKNOWN_LINUX_MUSL}}"
    end
  end

  def install
    bin.install "cdx-bin"
  end

  def caveats
    <<~EOS
      cdx needs a small shell function to change your shell's folder.
      Add one line to your shell config, then open a new terminal:

        bash:  eval "$(cdx-bin init bash)"     (in ~/.bashrc)
        zsh:   eval "$(cdx-bin init zsh)"      (in ~/.zshrc)
        fish:  cdx-bin init fish | source      (in ~/.config/fish/config.fish)
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/cdx-bin --version")
    assert_match "function", shell_output("#{bin}/cdx-bin init fish")
  end
end
